{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "./01_FRONTEND_USER_INTERFACE/components/*"
      ],
      "@/hooks/*": [
        "./01_FRONTEND_USER_INTERFACE/hooks/*"
      ],
      "@/lib/security/*": [
        "./06_SECURITY_AND_ATTACK_DETECTION/engine/*"
      ],
      "@/lib/*": [
        "./02_BACKEND_SERVER/core/*"
      ],
      "@/app/*": [
        "./src/app/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
